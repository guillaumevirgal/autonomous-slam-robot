<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="idefix_lab">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu">
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="lab_room">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="wall_north">
        <pose>0 3 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>6 0.1 1</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>6 0.1 1</size></box></geometry></collision>
      </link>

      <link name="wall_south">
        <pose>0 -3 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>6 0.1 1</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>6 0.1 1</size></box></geometry></collision>
      </link>

      <link name="wall_east">
        <pose>3 0 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 6 1</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.1 6 1</size></box></geometry></collision>
      </link>

      <link name="wall_west">
        <pose>-3 0 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 6 1</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.1 6 1</size></box></geometry></collision>
      </link>

      <link name="wall_partition">
        <pose>-0.5 0.5 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>2 0.1 1</size></box></geometry>
          <material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>2 0.1 1</size></box></geometry></collision>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <name>table</name>
      <pose>1.8 1.8 0 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Chair</uri>
      <name>chair</name>
      <pose>-1.8 -1.8 0 0 0 1.57</pose>
    </include>

  </world>
</sdf>
